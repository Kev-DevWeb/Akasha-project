# =============================================
# JARVIS - Variables de Entorno (Ejemplo)
# =============================================
# Copia este archivo como .env.local y rellena cada valor

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Hugging Face ---
HF_ACCESS_TOKEN=your_huggingface_token_here

# --- Tuya IoT Cloud ---
TUYA_CLIENT_ID=your_tuya_client_id
TUYA_CLIENT_SECRET=your_tuya_client_secret
TUYA_BASE_URL=https://openapi.tuyaus.com

# --- Google Home Graph (opcional) ---
GOOGLE_HOME_CLIENT_ID=your_google_home_client_id
GOOGLE_HOME_CLIENT_SECRET=your_google_home_client_secret
GOOGLE_HOME_REFRESH_TOKEN=your_google_home_refresh_token

# --- Seguridad del Endpoint ---
# Genera una cadena aleatoria segura: openssl rand -hex 32
JARVIS_API_SECRET=change_me_with_a_random_secret_key

# --- App URL (para Keep-Alive) ---
NEXT_PUBLIC_APP_URL=https://tu-proyecto-jarvis.vercel.app
